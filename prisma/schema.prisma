generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum InquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  CLOSED
}

enum InternshipStatus {
  NEW
  REVIEWING
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  phone     String
  course    String
  mode      String
  message   String?       @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("inquiries")
}

model Internship {
  id             String           @id @default(cuid())
  fullName       String
  phone          String
  email          String
  city           String
  education      String
  areaOfInterest String
  preferredArea  String
  message        String?          @db.Text
  resumeUrl      String
  status         InternshipStatus @default(NEW)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("internships")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  category    String
  eventDate   DateTime
  location    String
  bannerImage String
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model GalleryItem {
  id        String   @id @default(cuid())
  image     String
  category  String
  caption   String?  @db.Text
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery_items")
}

model AcademyVideo {
  id        String   @id @default(cuid())
  title     String
  videoUrl  String
  category  String
  duration  String?
  thumbnail String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academy_videos")
}
