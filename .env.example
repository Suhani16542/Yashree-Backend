PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/yashree_db

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Cookie Settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Initial Admin Account
ADMIN_NAME=Yashree Institute Admin
ADMIN_EMAIL=admin@yashreeinstitute.com
ADMIN_PASSWORD=

# Storage Provider (local | cloudinary)
STORAGE_PROVIDER=local

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Notifications
WHATSAPP_ENABLED=false
WHATSAPP_RECIPIENT_NUMBER=

# Twilio WhatsApp API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# AiSensy WhatsApp API
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=
AISENSY_SENDER_NUMBER=

# Brevo Email Notifications
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Yashree Institute
NOTIFICATION_EMAIL=
